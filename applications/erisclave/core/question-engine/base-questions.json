{
  "sections": [
    {
      "id": "s1",
      "num": "01",
      "color": "violet",
      "title": "Resume en une phrase",
      "hint": "Decris la feature en une seule phrase, comme si tu l'expliquais a quelqu'un qui n'a jamais entendu parler du jeu.",
      "required": true,
      "fields": [
        {
          "id": "summary",
          "type": "text",
          "label": "Resume",
          "placeholder": "Ex : Les Tourelles permettent aux factions de defendre leur base automatiquement.",
          "maxLength": 220,
          "required": true
        }
      ]
    },
    {
      "id": "s2",
      "num": "02",
      "color": "violet",
      "title": "Contexte & Pourquoi cette feature",
      "required": true,
      "fields": [
        { "id": "problem",   "type": "longtext", "label": "Probleme ou besoin identifie",  "placeholder": "Quel manque cette feature comble ?", "required": true },
        { "id": "objective", "type": "longtext", "label": "Objectif principal",            "placeholder": "Que pourra faire le joueur grace a ca ?", "required": true },
        { "id": "links",     "type": "longtext", "label": "Lien avec d'autres features",   "placeholder": "Dependances avec d'autres systemes" }
      ]
    },
    {
      "id": "s3",
      "num": "03",
      "color": "violet",
      "title": "Experience joueur cible",
      "fields": [
        {
          "id": "audience",
          "type": "checklist",
          "label": "Qui est le joueur concerne ?",
          "multi": true,
          "options": [
            "Tous les joueurs",
            "Joueurs en faction",
            "Joueurs sans faction",
            "Chefs / officiers de faction",
            "Joueurs PvP agressifs",
            "Joueurs defensifs / constructeurs",
            "Joueurs PvE",
            "Nouveaux joueurs",
            "Joueurs endgame"
          ]
        },
        { "id": "feeling",  "type": "longtext", "label": "Que doit RESSENTIR le joueur ?", "placeholder": "Puissance, tension, satisfaction, surprise..." },
        { "id": "scenario", "type": "longtext", "label": "Scenario de jeu typique",        "placeholder": "Raconte comment un joueur decouvre et utilise la feature, comme une petite histoire." }
      ]
    },
    {
      "id": "s4",
      "num": "04",
      "color": "cyan",
      "title": "Mecanique de jeu",
      "required": true,
      "fields": [
        { "id": "mechanic", "type": "longtext", "label": "Description detaillee", "placeholder": "Comment la feature fonctionne, etape par etape.", "required": true },
        {
          "id": "actions",
          "type": "table",
          "label": "Actions disponibles pour le joueur",
          "columns": [
            { "id": "action",    "label": "Action",            "type": "text" },
            { "id": "how",       "label": "Comment ?",         "type": "text" },
            { "id": "condition", "label": "Condition requise", "type": "text" }
          ]
        },
        { "id": "automatic", "type": "longtext", "label": "Comportements automatiques", "placeholder": "Timers, effets passifs, cooldowns..." }
      ]
    },
    {
      "id": "s5",
      "num": "05",
      "color": "cyan",
      "title": "Interface & Retours visuels",
      "fields": [
        { "id": "visuals", "type": "longtext", "label": "Ce que le joueur VOIT",   "placeholder": "Animations, particules, couleurs, textes..." },
        { "id": "audio",   "type": "longtext", "label": "Ce que le joueur ENTEND", "placeholder": "Sons declencheurs : clic, explosion, notification..." },
        { "id": "menus",   "type": "longtext", "label": "Menus ou interfaces",     "placeholder": "Decris le contenu de chaque ecran." }
      ]
    },
    {
      "id": "s6",
      "num": "06",
      "color": "cyan",
      "title": "Equilibrage & Valeurs",
      "fields": [
        {
          "id": "balancing",
          "type": "table",
          "label": "Parametres d'equilibrage",
          "columns": [
            { "id": "param",         "label": "Parametre",       "type": "text" },
            { "id": "value",         "label": "Valeur proposee", "type": "text" },
            { "id": "justification", "label": "Justification",   "type": "text" }
          ]
        },
        { "id": "playerEditable",   "type": "longtext", "label": "Modifiable par le joueur",        "placeholder": "Quels reglages le joueur peut-il changer ?" },
        { "id": "playerNotEditable","type": "longtext", "label": "Fixe pour des raisons d'equilibre", "placeholder": "Quelles valeurs ne changent jamais ?" }
      ]
    },
    {
      "id": "s7",
      "num": "07",
      "color": "green",
      "title": "Conditions & Regles metier",
      "fields": [
        { "id": "always",   "type": "list", "label": "Doit toujours", "placeholder": "Une regle par ligne", "itemLabel": "Regle" },
        { "id": "never",    "type": "list", "label": "Ne doit jamais", "placeholder": "Une regle par ligne", "itemLabel": "Regle" },
        { "id": "edgeCases","type": "list", "label": "Cas particuliers a gerer", "placeholder": "Que se passe-t-il si...", "itemLabel": "Cas" }
      ]
    },
    {
      "id": "s8",
      "num": "08",
      "color": "green",
      "title": "Ressources & Progression",
      "fields": [
        { "id": "obtention", "type": "longtext", "label": "Comment le joueur obtient cette feature", "placeholder": "Craft ? Achat ? Quete ? Tier ?" },
        {
          "id": "cost",
          "type": "table",
          "label": "Cout ou prerequis",
          "columns": [
            { "id": "element",  "label": "Element",      "type": "text" },
            { "id": "amount",   "label": "Quantite",     "type": "text" },
            { "id": "obtained", "label": "Obtenu comment", "type": "text" }
          ]
        },
        { "id": "progression", "type": "longtext", "label": "Progression possible", "placeholder": "Niveaux, ameliorations, variantes..." }
      ]
    },
    {
      "id": "s9",
      "num": "09",
      "color": "green",
      "title": "Interactions avec d'autres systemes",
      "fields": [
        {
          "id": "interactions",
          "type": "checklist",
          "label": "Systemes en interaction",
          "multi": true,
          "options": [
            "Factions",
            "Territoire / Claims",
            "PvP",
            "Economie / Shop",
            "Crafting",
            "Permissions / Grades",
            "Evenements / Raids",
            "Interface / HUD",
            "WorldGen",
            "Magie",
            "Anti-cheat"
          ]
        },
        { "id": "interactionsDetail", "type": "longtext", "label": "Detail des interactions", "placeholder": "Pour chaque systeme coche, explique comment." }
      ]
    },
    {
      "id": "s10",
      "num": "10",
      "color": "gold",
      "title": "Hors perimetre",
      "hint": "Tres important : note explicitement ce qui n'est PAS inclus dans cette version.",
      "fields": [
        { "id": "outOfScope", "type": "list", "label": "Ce que cette feature ne fait PAS", "itemLabel": "Hors perimetre" }
      ]
    },
    {
      "id": "s11",
      "num": "11",
      "color": "orange",
      "title": "Risques & Points d'attention",
      "fields": [
        {
          "id": "risks",
          "type": "table",
          "label": "Risques identifies",
          "columns": [
            { "id": "risk",       "label": "Risque",     "type": "text" },
            { "id": "impact",     "label": "Impact",     "type": "text" },
            { "id": "mitigation", "label": "Suggestion", "type": "text" }
          ]
        }
      ]
    },
    {
      "id": "s12",
      "num": "12",
      "color": "red",
      "title": "Questions ouvertes",
      "fields": [
        { "id": "openQuestions", "type": "list", "label": "Ce qui n'est pas encore decide", "itemLabel": "Question" }
      ]
    },
    {
      "id": "s13",
      "num": "13",
      "color": "violet",
      "title": "Inspirations & References",
      "fields": [
        { "id": "inspirations", "type": "list",     "label": "Inspirations",          "itemLabel": "Reference" },
        { "id": "assets",       "type": "image",    "label": "Images de reference",   "multi": true }
      ]
    },
    {
      "id": "s14",
      "num": "14",
      "color": "violet",
      "title": "Notes supplementaires",
      "fields": [
        { "id": "notes", "type": "longtext", "label": "Tout ce qui ne rentre pas ailleurs" }
      ]
    }
  ]
}
